{
  "name": "opencodez-free",
  "version": "1.0.0",
  "private": true,
  "description": "Local OpenAI-compatible server for OpenCode Zen's free anonymous model lane, with a built-in web panel. No API key, no login, no build step.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "opencodez": "./src/index.ts"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "test": "node --test \"test/*.test.ts\"",
    "check": "node --check src/index.ts"
  },
  "keywords": [
    "opencode",
    "opencode-zen",
    "openai-compatible",
    "free-models",
    "local-server",
    "llm-gateway"
  ],
  "license": "MIT"
}
